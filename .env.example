# 共享环境变量示例（server 与 web 共用一份，仓库根目录）
#
# 加载方与优先级：
#   - server（process.loadEnvFile，先入为主）：
#       进程环境变量 > .env.{NODE_ENV} > .env
#   - web（Vite 按 mode 加载，envDir 指向仓库根目录）：
#       vite dev 读 .env + .env.development；vite build 读 .env + .env.production
#
# 规则：
#   - NODE_ENV 只能由进程环境变量指定（写进文件不生效），默认 development
#   - 仅 VITE_ 前缀的变量会进入前端构建产物，机密配置严禁使用该前缀
#   - 机密写在 .env.local / .env.{mode}.local（已 gitignore），不要提交
#
# 生产启动示例（PowerShell）：$env:NODE_ENV="production"; pnpm start
#                （bash）    ：NODE_ENV=production pnpm start

# ---- server ----

# HTTP 监听端口，默认 8081
PORT=8081

# 日志等级：debug | info | warn | error
# 默认 development=debug，production=info
LOG_LEVEL=debug

# 正式环境允许的跨域来源，逗号分隔（如 https://app.example.com）
# 为空表示不下发 CORS 头；开发环境未配置时默认 *（放行所有来源）
CORS_ORIGIN=

# MQTT 服务地址（预留，暂无消费方）
MQTT_SERVER=

# ---- web ----

# API 基础路径（注意：不要以 / 结尾）
# 开发环境走 Vite 代理；正式部署可改为完整后端地址
VITE_API_BASE=/v1/api

# Vite 开发服务器代理目标（仅 vite.config.ts 使用，对 /v1/api 的转发目标）
VITE_PROXY_TARGET=http://localhost:8081
